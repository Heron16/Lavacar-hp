# ============================================================
#  AquaWash — Variáveis de ambiente (copie para .env)
#  NUNCA commite o arquivo .env real no repositório
# ============================================================

# --- MySQL ---
MYSQL_ROOT_PASSWORD=your_root_password_here
MYSQL_DATABASE=carwash
MYSQL_USER=carwash_user
MYSQL_PASSWORD=your_db_password_here

# --- Backend ---
PORT=3001
DATABASE_URL=mysql://carwash_user:your_db_password_here@mysql:3306/carwash
# Cache distribuído Redis (docker-compose: redis://redis:6379 | local: redis://localhost:6379)
REDIS_URL=redis://redis:6379
JWT_SECRET=your_super_secret_jwt_key_change_in_production
JWT_EXPIRES_IN=7d
# Origens permitidas pelo CORS (separe múltiplas com vírgula)
CORS_ORIGIN=http://localhost:5173,https://meuapp.local

# --- Frontend (Vite build-time) ---
VITE_API_URL=https://meuapp.local/api
